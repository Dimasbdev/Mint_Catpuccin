#!/usr/bin/env bash
# ==============================================================================
#  kitty-fast: Ultra-low latency terminal launcher for Mint-Catppuccin
#  Leverages the pre-warmed background Kitty daemon via UNIX socket.
#  Startup latency is ~30-50ms (virtually instantaneous).
# ==============================================================================

SOCKET="unix:@kitty-$UID"
CWD="${PWD:-$HOME}"

# 1. Fast path: If daemon is running, spawn new OS window immediately (<50ms)
if kitten @ --to "$SOCKET" launch --type=os-window --cwd="$CWD" "$@" >/dev/null 2>&1; then
    exit 0
fi

# 2. Daemon recovery: If daemon isn't running, start it via systemd or direct binary
systemctl --user start kitty-daemon.service >/dev/null 2>&1 || "${HOME}/.local/bin/kitty-daemon" &

# Wait briefly for daemon to initialize and retry
for _ in {1..30}; do
    if kitten @ --to "$SOCKET" launch --type=os-window --cwd="$CWD" "$@" >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.05
done

# 3. Ultimate Fallback: Direct standalone launch if daemon fails
kitty --detach -o allow_remote_control=yes --listen-on "$SOCKET" --directory="$CWD" "$@"
exit 0
