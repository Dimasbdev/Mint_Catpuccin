## Bento x Catppuccin CAVA Configuration
## Dynamic Theme Integration: Colors are synchronized per workspace

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 2
gradient_color_1 = '#cba6f7'
gradient_color_2 = '#f5c2e7'

[smoothing]
integral = 77
monstercat = 0
waves = 0
gravity = 100
ignore = 0
