{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/eva.png",
        "type": "kitty-direct",
        "width": 32,
        "height": 16,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ➜  ",
        "color": {
            "keys": "cyan",
            "title": "magenta"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS",
            "keyColor": "cyan"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "cyan"
        },
        {
            "type": "de",
            "key": "󰧨 DE",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "theme",
            "key": "󰉼 Theme",
            "keyColor": "cyan"
        },
        {
            "type": "icons",
            "key": "󰀻 Icons",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "󰘚 GPU",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "󰑭 Memory",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "key": "󱈑 Battery",
            "keyColor": "cyan"
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
