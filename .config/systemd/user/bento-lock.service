[Unit]
Description=Bento Lockscreen Pre-Warmed Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/bento-lock/lock.py --daemon
Restart=always
RestartSec=1
Environment=DISPLAY=:0
Environment=LD_LIBRARY_PATH=/usr/libexec/cinnamon-screensaver
Environment=GI_TYPELIB_PATH=/usr/libexec/cinnamon-screensaver/girepository-1.0

[Install]
WantedBy=graphical-session.target
